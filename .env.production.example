# ===========================================
# MiniShop Production Environment
# Copy this to .env.production and update values
# ===========================================

# Database Configuration
DB_DATABASE=minishop
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Database Host (use 'mysql' in docker, or actual host for production)
DB_HOST=mysql
DB_PORT=3306

# Backend Configuration
APP_ENV=production
APP_URL=http://3.0.57.127:8000
BACKEND_HOST_PORT=8000

# JWT Configuration (use strong, random values in production)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ISSUER=minishop-api
JWT_AUDIENCE=minishop-web
JWT_TTL=3600

# Frontend Configuration
FRONTEND_URL=http://3.0.57.127:4000
NEXT_PUBLIC_API_URL=http://3.0.57.127:8000/api
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false

# MySQL Port Mapping (optional, change if you want different host port)
MYSQL_HOST_PORT=3307

# Frontend Port Mapping
FRONTEND_HOST_PORT=4000

# PHPMyAdmin (optional)
PHPMYADMIN_HOST_PORT=8080
