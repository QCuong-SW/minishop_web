# ==========================================
# SHOPEE MINI — ENVIRONMENT CONFIGURATION
# ==========================================

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopee_mini
DB_USERNAME=app
DB_PASSWORD=app
MYSQL_ROOT_PASSWORD=change-me

# Docker host ports (container ports remain unchanged)
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=4000
PHPMYADMIN_HOST_PORT=8080

# Backend PHP API
APP_ENV=development
APP_PORT=8000
APP_URL=http://localhost:8000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=minishop-api
JWT_AUDIENCE=minishop-web
JWT_TTL=3600
FRONTEND_URL=http://localhost:4000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false
