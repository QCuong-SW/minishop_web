        <mxCell id="e-title" value="ERD NGHIỆP VỤ — MINISHOP" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="e1"><mxGeometry x="520" y="20" width="760" height="45" as="geometry"/></mxCell>
