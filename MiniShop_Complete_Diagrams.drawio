  <diagram id="database" name="04 - Database chi tiết">
    <mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="d0"/><mxCell id="d1" parent="d0"/>
        <mxCell id="d-title" value="DATABASE SCHEMA — MYSQL 8.0 / INNODB" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="d1"><mxGeometry x="520" y="20" width="860" height="45" as="geometry"/></mxCell>
        <mxCell id="d-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;name VARCHAR(100)&lt;br&gt;◆ UQ email VARCHAR(150)&lt;br&gt;password VARCHAR(255)&lt;br&gt;role ENUM(USER, ADMIN)&lt;br&gt;avatar_url VARCHAR(500) NULL&lt;br&gt;phone VARCHAR(20) NULL&lt;br&gt;address TEXT NULL&lt;br&gt;status ENUM(ACTIVE, BANNED)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="50" y="100" width="270" height="260" as="geometry"/></mxCell>
        <mxCell id="d-categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;name VARCHAR(100)&lt;br&gt;◆ UQ slug VARCHAR(120)&lt;br&gt;description TEXT NULL&lt;br&gt;image_url VARCHAR(500) NULL&lt;br&gt;status ENUM(ACTIVE, INACTIVE)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="390" y="100" width="270" height="220" as="geometry"/></mxCell>
        <mxCell id="d-products" value="&lt;b&gt;products&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK category_id → categories.id&lt;br&gt;name VARCHAR(255)&lt;br&gt;◆ UQ slug VARCHAR(280)&lt;br&gt;description LONGTEXT NULL&lt;br&gt;price, original_price DECIMAL(12,2)&lt;br&gt;stock INT UNSIGNED&lt;br&gt;image_url VARCHAR(500)&lt;br&gt;rating_avg DECIMAL(3,2)&lt;br&gt;rating_count INT UNSIGNED&lt;br&gt;status ENUM(ACTIVE, INACTIVE)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="730" y="100" width="300" height="310" as="geometry"/></mxCell>
        <mxCell id="d-images" value="&lt;b&gt;product_images&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK product_id → products.id&lt;br&gt;image_url VARCHAR(500)&lt;br&gt;sort_order INT&lt;br&gt;created_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="1100" y="100" width="270" height="175" as="geometry"/></mxCell>
        <mxCell id="d-cart" value="&lt;b&gt;cart_items&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK user_id → users.id&lt;br&gt;🔗 FK product_id → products.id&lt;br&gt;quantity INT UNSIGNED&lt;br&gt;◆ UQ (user_id, product_id)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="1440" y="100" width="280" height="195" as="geometry"/></mxCell>
        <mxCell id="d-coupons" value="&lt;b&gt;coupons&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;◆ UQ code VARCHAR(50)&lt;br&gt;description VARCHAR(255) NULL&lt;br&gt;discount_type ENUM(FIXED, PERCENT)&lt;br&gt;discount_value DECIMAL(12,2)&lt;br&gt;min_order_amount DECIMAL(12,2)&lt;br&gt;max_discount DECIMAL(12,2) NULL&lt;br&gt;expires_at DATETIME&lt;br&gt;usage_limit, used_count INT UNSIGNED&lt;br&gt;status ENUM(ACTIVE, EXPIRED, DISABLED)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="50" y="460" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="d-orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;◆ UQ order_code VARCHAR(50)&lt;br&gt;🔗 FK user_id → users.id&lt;br&gt;🔗 FK coupon_id → coupons.id NULL&lt;br&gt;total_amount, shipping_fee DECIMAL(12,2)&lt;br&gt;discount_amount, final_amount DECIMAL(12,2)&lt;br&gt;status ENUM(PENDING…CANCELLED)&lt;br&gt;payment_method ENUM(COD, MOCK_BANKING)&lt;br&gt;payment_status ENUM(UNPAID, PAID, REFUNDED)&lt;br&gt;shipping_name, shipping_phone&lt;br&gt;shipping_address TEXT, note TEXT NULL&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="430" y="460" width="335" height="330" as="geometry"/></mxCell>
        <mxCell id="d-order-items" value="&lt;b&gt;order_items&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK order_id → orders.id&lt;br&gt;🔗 FK product_id → products.id NULL&lt;br&gt;product_name_snapshot VARCHAR(255)&lt;br&gt;product_image_snapshot VARCHAR(500) NULL&lt;br&gt;unit_price DECIMAL(12,2)&lt;br&gt;quantity INT UNSIGNED&lt;br&gt;subtotal DECIMAL(12,2)&lt;br&gt;created_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="845" y="460" width="315" height="265" as="geometry"/></mxCell>
        <mxCell id="d-reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK user_id → users.id&lt;br&gt;🔗 FK product_id → products.id&lt;br&gt;🔗 FK order_id → orders.id NULL&lt;br&gt;rating TINYINT UNSIGNED CHECK 1..5&lt;br&gt;comment TEXT NULL&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="1240" y="460" width="300" height="225" as="geometry"/></mxCell>
        <mxCell id="d-wishlists" value="&lt;b&gt;wishlists&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK user_id → users.id&lt;br&gt;🔗 FK product_id → products.id&lt;br&gt;◆ UQ (user_id, product_id)&lt;br&gt;created_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="250" y="900" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="d-appointments" value="&lt;b&gt;appointments&lt;/b&gt;&lt;hr&gt;🔑 PK id BIGINT UNSIGNED&lt;br&gt;🔗 FK user_id → users.id&lt;br&gt;appointment_date DATE&lt;br&gt;appointment_time TIME&lt;br&gt;service_type VARCHAR(100)&lt;br&gt;guest_count INT UNSIGNED&lt;br&gt;note TEXT NULL&lt;br&gt;status ENUM(PENDING, CONFIRMED, CANCELLED, COMPLETED)&lt;br&gt;created_at, updated_at TIMESTAMP" style="shape=table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=12;container=1;collapsible=0;" vertex="1" parent="d1"><mxGeometry x="650" y="900" width="330" height="255" as="geometry"/></mxCell>
