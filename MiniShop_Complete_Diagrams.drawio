        <mxCell id="sm2" value="2. POST /coupons/validate (tùy chọn)" style="html=1;endArrow=block;strokeColor=#334155;fontSize=12;" edge="1" parent="s1" source="s-ui" target="s-api"><mxGeometry relative="1" y="-0.65" as="geometry"><Array as="points"><mxPoint x="490" y="300"/><mxPoint x="610" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="sm3" value="3. HTTP JSON + user header" style="html=1;endArrow=block;strokeColor=#334155;fontSize=12;" edge="1" parent="s1" source="s-api" target="s-router"><mxGeometry relative="1" y="-0.52" as="geometry"><Array as="points"><mxPoint x="770" y="360"/><mxPoint x="890" y="360"/></Array></mxGeometry></mxCell>
