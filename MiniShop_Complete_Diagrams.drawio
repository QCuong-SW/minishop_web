        <mxCell id="sm11" value="11. SELECT cart + products FOR UPDATE" style="html=1;endArrow=block;strokeColor=#9333EA;fontSize=12;" edge="1" parent="s1" source="s-order" target="s-db"><mxGeometry relative="1" y="0.28" as="geometry"><Array as="points"><mxPoint x="1360" y="760"/><mxPoint x="1490" y="760"/></Array></mxGeometry></mxCell>
