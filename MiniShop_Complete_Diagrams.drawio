        <mxCell id="sm5" value="5. Trả kết quả coupon" style="html=1;endArrow=open;dashed=1;strokeColor=#64748B;fontSize=12;" edge="1" parent="s1" source="s-router" target="s-ui"><mxGeometry relative="1" y="-0.32" as="geometry"><Array as="points"><mxPoint x="890" y="460"/><mxPoint x="490" y="460"/></Array></mxGeometry></mxCell>
        <mxCell id="sm6" value="6. Xác nhận đặt hàng" style="html=1;endArrow=block;strokeColor=#334155;fontSize=12;" edge="1" parent="s1" source="s-customer" target="s-ui"><mxGeometry relative="1" y="-0.22" as="geometry"><Array as="points"><mxPoint x="220" y="510"/><mxPoint x="330" y="510"/></Array></mxGeometry></mxCell>
        <mxCell id="sm7" value="7. POST /orders + shipping + payment + coupon" style="html=1;endArrow=block;strokeColor=#334155;fontSize=12;" edge="1" parent="s1" source="s-ui" target="s-api"><mxGeometry relative="1" y="-0.12" as="geometry"><Array as="points"><mxPoint x="490" y="560"/><mxPoint x="610" y="560"/></Array></mxGeometry></mxCell>
